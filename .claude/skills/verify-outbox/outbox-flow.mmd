---
title: "A note you write offline, and what the outbox does with it"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: Not written
    lg1: In between
    lg2: Saved
    lg3: Removed
  }
  class lg0 blue
  class lg1 yellow
  class lg2 teal
  class lg3 tan
  state "At the same time" as all {
    state "Network" as r0 {
      s0: Online
      s1: Offline
      [*] --> s0
      s0 --> s1: the network drops
      s1 --> s0: the network comes back
    }
    --
    state "Your new note" as r1 {
      s2: Not written yet
      s3: On the library#59; a copy still waits here
      s4: Saved on the library
      s5: Waits on this device
      s6: Removed#59; a copy of the removal still waits here
      s7: Removed
      s8: Library has the old words#59; the new words wait here
      s9: Removed here#59; the removal waits on this device
      [*] --> s2
      s2 --> s3: you write a note#59; the library stores it but its answer is lost [when Online]
      s2 --> s4: you write a note [when Online]
      s2 --> s5: you write a note [when Offline]
      s3 --> s8: the edit goes behind the change of your new note that still waits
      s3 --> s9: the removal goes behind the change of your new note that still waits
      s4 --> s3: the library takes the edit but its answer is lost#59; it waits here too [when Online]
      s4 --> s6: the library takes the removal but its answer is lost#59; it waits here too [when Online]
      s4 --> s7: the removal is sent at once [when Online]
      s4 --> s8: no network: the edit waits here [when Offline]
      s4 --> s9: no network: the removal waits here [when Offline]
      s5 --> s6: the removal goes behind the change of your new note that still waits
      s3 --> s4: the library's answer reaches the page#59; the copy here is deleted [when Online]
      s5 --> s3: the library takes the new note [when Online]
      s6 --> s7: the library's answer reaches the page#59; the copy here is deleted [when Online]
      s4 --> s8: the edit goes behind the change of your new note that still waits
      s4 --> s9: the removal goes behind the change of your new note that still waits
      s8 --> s3: the library takes an edit [when Online]
      s9 --> s6: the library takes a removal [when Online]
      s5 --> s8: the library takes the new note, a copy read before your last change [when Online]
      s6 --> s9: the library takes the new note, a copy read before your last change [when Online]
    }
  }
  class s2 blue
  class s3 yellow
  class s4 teal
  class s5 yellow
  class s6 tan
  class s7 tan
  class s8 yellow
  class s9 tan
