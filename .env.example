# Names of the settings the app reads at run time. Never put real values here.
# On Railway these already exist on the `web` service (see PROGRESS.md).

# Database (Postgres on Railway). Without it the app uses PGlite, an
# in-process Postgres kept in PGLITE_DIR (or in memory): fine for tests and
# local development, not for production.
DATABASE_URL=
PGLITE_DIR=

# One-time code for creating the owner account at /setup. Optional: if
# blank, the server makes one up and prints it in its log at start-up.
SETUP_CODE=

# Where files go when no bucket is configured (development and tests).
FILES_DIR=

# File bucket (S3-compatible, Railway). Used from M3.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_URL_STYLE=

# Voice (M7)
ELEVENLABS_API_KEY=
# What ElevenLabs charges per 1,000 characters on your plan (blank = $0.30,
# a cautious overage price), and the reading-aloud spending caps in US
# dollars (blank = $5 per book, $20 per month). Stored audio is free.
ELEVENLABS_USD_PER_1K_CHARS=
# Transcripts of voice notes (M8): price per hour of audio (blank = $1, cautious).
ELEVENLABS_STT_USD_PER_HOUR=
VOICE_CAP_PER_BOOK_USD=
VOICE_CAP_PER_MONTH_USD=

# Text AI (M6) and image generation (M9). Added later by Samuel.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Generated pictures (M9): price per picture (blank = $0.20, cautious) and
# caps in US dollars (blank = $5 per book, $20 per month).
OPENAI_IMAGE_USD=
IMAGE_CAP_PER_BOOK_USD=
IMAGE_CAP_PER_MONTH_USD=

# Spending caps for AI, in US dollars (ground rule 8). Blank = $5 per book,
# $20 per month across all readers. Stored answers are free and always served.
AI_CAP_PER_BOOK_USD=
AI_CAP_PER_MONTH_USD=

# Set to 1 to use the fake AI and fake voice (free, made-up answers and a
# test tone) instead of Claude and ElevenLabs.
# The browser tests set it; never set it in production.
AI_FAKE=

# Model for one AI feature, in place of its built-in default (lib/ai/model.ts).
# One variable per feature, for example AI_MODEL_REWRITE or AI_MODEL_XRAY.
# AI_MODEL_REWRITE=

# Google Books key for the cover finder (lib/covers/sources.ts). Blank = Open
# Library only.
GOOGLE_BOOKS_API_KEY=

# Set to off to stop the automatic cover lookups (the browser tests do).
COVER_LOOKUP=

# Set to fake to use the made-up paper catalogue in place of Crossref and PubMed.
PAPER_LOOKUP=

# The commit the server reports at /api/health. Set by the Deploy workflow
# (NEOLIBRARY_COMMIT) or by Railway when it builds from GitHub
# (RAILWAY_GIT_COMMIT_SHA); nothing to set by hand.
# NEOLIBRARY_COMMIT=
