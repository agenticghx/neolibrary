# Names of the settings the app reads at run time. Never put real values here.
# On Railway these already exist on the `web` service (see PROGRESS.md).

# Database (Postgres on Railway). Used from M2.
DATABASE_URL=

# File bucket (S3-compatible, Railway). Used from M3.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_URL_STYLE=

# Voice (M7)
ELEVENLABS_API_KEY=

# Text AI (M6) and image generation (M9). Added later by Samuel.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
